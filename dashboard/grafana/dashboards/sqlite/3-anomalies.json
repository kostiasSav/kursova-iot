          "rawQueryText": "SELECT no AS \"№\", class AS \"Клас\", complexity AS \"Складність\",\n       replace(devices, ',', ', ') AS \"Пристрої\", start_ts AS \"Початок\", end_ts AS \"Кінець\",\n       hours AS \"Тривалість, год\", confidence AS \"Впевненість\",\n       CASE scored WHEN 1 THEN 'так' ELSE 'ні' END AS \"Буде оцінено\",\n       evidence AS \"Обґрунтування\", first_device, zoom_from_ms, zoom_to_ms\nFROM findings ORDER BY start_ts",
