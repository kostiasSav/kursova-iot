          "rawQueryText": "SELECT count(*) AS \"Знахідок у файлі\", count(DISTINCT class) AS \"Різних класів\",\n       coalesce(sum(scored), 0) AS \"Буде оцінено (не більше 15)\"\nFROM findings",
