          "queryType": "table",
          "rawQueryText": "-- Кожна знахідка — окремий рядок: на початку значення = номер класу,\n-- у момент завершення = 0 (там смуга обривається).\nSELECT start_ts AS time, label, class_code AS \"клас\" FROM findings\nUNION ALL\nSELECT end_ts AS time, label, 0 AS \"клас\" FROM findings\nORDER BY time",
          "queryText": "-- Кожна знахідка — окремий рядок: на початку значення = номер класу,\n-- у момент завершення = 0 (там смуга обривається).\nSELECT start_ts AS time, label, class_code AS \"клас\" FROM findings\nUNION ALL\nSELECT end_ts AS time, label, 0 AS \"клас\" FROM findings\nORDER BY time",
