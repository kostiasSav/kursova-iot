          "query": "import \"strings\"\nfrom(bucket: \"dashboard\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"findings\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({\"№\": r.no, \"Клас\": r.class, \"Складність\": r.complexity,\n                      \"Пристрої\": strings.replaceAll(v: r.devices, t: \",\", u: \", \"),\n                      \"Початок\": r._time,\n                      \"Кінець\": time(v: r.end_ts * 1000000000), \"Тривалість, год\": r.hours,\n                      \"Впевненість\": r.confidence,\n                      \"Буде оцінено\": if r.scored == 1 then \"так\" else \"ні\",\n                      \"Обґрунтування\": r.evidence, first_device: r.first_device,\n                      zoom_from_ms: r.zoom_from_ms, zoom_to_ms: r.zoom_to_ms}))"
        }
