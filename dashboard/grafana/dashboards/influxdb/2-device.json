    {
      "type": "timeseries",
      "title": "$metric",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "kursova-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "kursova-influxdb"
          },
          "query": "// Середнє, мінімум і максимум за кожен інтервал графіка (v.windowPeriod).\ndata = from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${metric}\" and r.device_id == \"${device}\"\n                       and r._field == \"value\")\n  |> keep(columns: [\"_time\", \"_value\", \"_start\", \"_stop\"])\nunion(tables: [\n    data |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false, timeSrc: \"_start\")\n         |> set(key: \"_field\", value: \"середнє\"),\n    data |> aggregateWindow(every: v.windowPeriod, fn: min, createEmpty: false, timeSrc: \"_start\")\n         |> set(key: \"_field\", value: \"мінімум\"),\n    data |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false, timeSrc: \"_start\")\n         |> set(key: \"_field\", value: \"максимум\"),\n])\n  |> group(columns: [\"_field\"])\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "repeat": "metric",
      "repeatDirection": "v",
      "maxDataPoints": 1500,
      "description": "Лінія — середнє за інтервал, сіра смуга — від мінімуму до максимуму. Кольорові ділянки — знахідки з findings.json для цього пристрою.",
