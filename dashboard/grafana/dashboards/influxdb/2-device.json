    {
      "type": "table",
      "title": "Показники пристрою за весь час",
      "description": "",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 17,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "kursova-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "kursova-influxdb"
          },
          "query": "// За весь час, незалежно від обраного періоду.\nimport \"join\"\ndata = from(bucket: \"iot\")\n  |> range(start: 1970-01-01T00:00:00Z, stop: 2100-01-01T00:00:00Z)\n  |> filter(fn: (r) => r.device_id == \"${device}\" and r._field == \"value\")\ncounts = data |> count() |> group() |> map(fn: (r) => ({metric: r._measurement, n: r._value}))\nfirsts = data |> first() |> group() |> map(fn: (r) => ({metric: r._measurement, first: r._time}))\nlasts = data |> last() |> group() |> map(fn: (r) => ({metric: r._measurement, last: r._time}))\nunits = from(bucket: \"dashboard\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"units\")\n  |> group()\n  |> map(fn: (r) => ({metric: r.metric, unit: r._value}))\njoin.inner(left: counts, right: firsts, on: (l, r) => l.metric == r.metric,\n    as: (l, r) => ({l with first: r.first}))\n  |> join.inner(right: lasts, on: (l, r) => l.metric == r.metric,\n    as: (l, r) => ({l with last: r.last}))\n  |> join.left(right: units, on: (l, r) => l.metric == r.metric,\n    as: (l, r) => ({\"Показник\": l.metric, \"Одиниця\": if exists r.unit then r.unit else \"\",\n                    \"Записів\": l.n, \"Перший\": l.first, \"Останній\": l.last,\n                    \"Середній інтервал, с\": float(v: int(v: l.last) - int(v: l.first))\n                        / 1000000000.0 / float(v: if l.n > 1 then l.n - 1 else 1)}))\n  |> sort(columns: [\"Показник\"])"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
