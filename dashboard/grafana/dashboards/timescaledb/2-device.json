      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kursova-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "-- Середнє, мінімум і максимум за кожен інтервал графіка ($__interval).\nSELECT $__timeGroupAlias(ts, $__interval),\n       avg(value) AS \"середнє\", min(value) AS \"мінімум\", max(value) AS \"максимум\"\nFROM readings\nWHERE device_id = '$device' AND metric = '$metric' AND $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "repeat": "metric",
      "repeatDirection": "v",
      "maxDataPoints": 1500,
      "description": "Лінія — середнє за інтервал, сіра смуга — від мінімуму до максимуму. Кольорові ділянки — знахідки з findings.json для цього пристрою.",
