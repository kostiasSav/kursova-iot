          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT type AS \"Тип\", zone AS \"Зона\", gateway AS \"Шлюз\",\n       interval_s AS \"Інтервал за маніфестом, с\"\nFROM devices WHERE device_id = '$device'"
