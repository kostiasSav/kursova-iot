    {
      "type": "table",
      "title": "Показники пристрою за весь час",
      "description": "",
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 17,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kursova-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kursova-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "-- За весь час, незалежно від обраного періоду.\nSELECT r.metric AS \"Показник\", coalesce(u.unit, '') AS \"Одиниця\", count(*) AS \"Записів\",\n       min(r.ts) AS \"Перший\", max(r.ts) AS \"Останній\",\n       round((extract(epoch FROM max(r.ts) - min(r.ts)) / greatest(count(*) - 1, 1))::numeric, 1)\n           AS \"Середній інтервал, с\"\nFROM readings r LEFT JOIN units u ON u.metric = r.metric\nWHERE r.device_id = '$device'\nGROUP BY r.metric, u.unit ORDER BY r.metric"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
