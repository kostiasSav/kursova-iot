    {
      "type": "table",
      "title": "Зведення за групами: $group_by",
      "description": "Доступність — частка годин, коли пристрої групи надсилали хоч щось.",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kursova-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kursova-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "-- Доступність = частка годин, коли пристрої групи надсилали дані.\nWITH counts AS (\n    SELECT device_id, time_bucket(interval '1 hour', ts) AS hour, count(*) AS n,\n           max(ts) AS last_ts\n    FROM readings WHERE $__timeFilter(ts)\n    GROUP BY 1, 2),\nspan AS (SELECT extract(epoch FROM max(hour) - min(hour)) / 3600 + 1 AS hours FROM counts),\nper_device AS (\n    SELECT device_id, count(*) AS hours, sum(n) AS n, max(last_ts) AS last_ts\n    FROM counts GROUP BY device_id),\neveryone AS (SELECT device_id FROM devices UNION SELECT device_id FROM per_device)\nSELECT coalesce(d.$group_by, 'немає в маніфесті') AS \"Група\",\n       count(d.device_id) AS \"Пристроїв у маніфесті\",\n       count(p.device_id) AS \"Пристроїв у даних\",\n       coalesce(sum(p.n), 0) AS \"Повідомлень\",\n       round((100.0 * coalesce(sum(p.hours), 0) / (count(*) * (SELECT hours FROM span)))::numeric, 1)\n           AS \"Доступність, %\",\n       max(p.last_ts) AS \"Останнє повідомлення\"\nFROM everyone e\nLEFT JOIN devices d ON d.device_id = e.device_id\nLEFT JOIN per_device p ON p.device_id = e.device_id\nGROUP BY 1 ORDER BY 1"
        }
      ],
