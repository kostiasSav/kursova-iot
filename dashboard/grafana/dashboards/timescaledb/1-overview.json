          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "kursova-timescaledb"
              },
              "editorMode": "code",
              "rawQuery": true,
              "format": "table",
              "rawSql": "WITH per_device AS (\n    SELECT device_id, count(*) AS n, min(ts) AS first_ts, max(ts) AS last_ts\n    FROM readings WHERE $__timeFilter(ts)\n    GROUP BY device_id),\neveryone AS (SELECT device_id FROM devices UNION SELECT device_id FROM per_device)\nSELECT e.device_id AS \"Пристрій\", d.type AS \"Тип\",\n       coalesce(d.zone, 'немає в маніфесті') AS \"Зона\", d.gateway AS \"Шлюз\",\n       CASE WHEN d.device_id IS NULL THEN 'ні' ELSE 'так' END AS \"У маніфесті\",\n       coalesce(p.n, 0) AS \"Повідомлень\", p.first_ts AS \"Перше\", p.last_ts AS \"Останнє\"\nFROM everyone e\nLEFT JOIN devices d ON d.device_id = e.device_id\nLEFT JOIN per_device p ON p.device_id = e.device_id\nORDER BY d.zone NULLS LAST, e.device_id"
            }
          ],
