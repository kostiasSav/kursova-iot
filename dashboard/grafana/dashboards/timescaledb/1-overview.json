    {
      "type": "status-history",
      "title": "Повідомлення, % від звичайного для пристрою",
      "description": "Рядок — пристрій (і його зона), клітинка — інтервал часу: 1 год для коротких періодів, кілька годин для довгих (наведіть курсор). Звичайне = середня кількість повідомлень пристрою за такий інтервал в обраному періоді.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 30
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kursova-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kursova-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "-- Повідомлень від кожного пристрою за кожен інтервал ($__interval: 1 год для\n-- коротких періодів, кілька годин для довгих), у % від звичайної (середньої)\n-- кількості для цього пристрою. Інтервал без жодного повідомлення дає 0 % —\n-- він червоний.\nWITH cells AS (\n    SELECT generate_series(time_bucket('$__interval', $__timeFrom()::timestamptz),\n                           $__timeTo()::timestamptz - interval '1 second',\n                           '$__interval'::interval) AS t),\ncounts AS (\n    SELECT device_id, time_bucket('$__interval', ts) AS t, count(*) AS n\n    FROM readings WHERE $__timeFilter(ts)\n    GROUP BY 1, 2),\nusual AS (SELECT device_id, avg(n) AS n FROM counts GROUP BY 1)\nSELECT cells.t AS time,\n       coalesce(d.zone, 'немає в маніфесті') || ' · ' || usual.device_id AS device,\n       round(100.0 * coalesce(counts.n, 0) / usual.n) AS pct\nFROM cells CROSS JOIN usual\nLEFT JOIN counts ON counts.device_id = usual.device_id AND counts.t = cells.t\nLEFT JOIN devices d ON d.device_id = usual.device_id\nORDER BY 1, d.zone NULLS LAST, usual.device_id"
        }
      ],
      "interval": "1h",
      "maxDataPoints": 200,
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "device"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "options": {
        "showValue": "never",
        "rowHeight": 0.92,
        "colWidth": 1,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
