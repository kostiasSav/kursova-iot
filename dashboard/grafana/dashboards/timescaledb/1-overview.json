    {
      "type": "status-history",
      "title": "Те саме за групами: $group_by",
      "description": "Сума повідомлень пристроїв групи за інтервал, у % від звичайного для групи. Групу (зона чи шлюз) обирають угорі.",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "kursova-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "kursova-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "-- Те саме, але сумарно для кожної зони або шлюзу (змінна «Групувати за»).\nWITH cells AS (\n    SELECT generate_series(time_bucket('$__interval', $__timeFrom()::timestamptz),\n                           $__timeTo()::timestamptz - interval '1 second',\n                           '$__interval'::interval) AS t),\nper_device AS (\n    SELECT device_id, time_bucket('$__interval', ts) AS t, count(*) AS n\n    FROM readings WHERE $__timeFilter(ts)\n    GROUP BY 1, 2),\ncounts AS (\n    SELECT coalesce(d.$group_by, 'немає в маніфесті') AS grp, p.t, sum(p.n) AS n\n    FROM per_device p LEFT JOIN devices d ON d.device_id = p.device_id\n    GROUP BY 1, 2),\nusual AS (SELECT grp, avg(n) AS n FROM counts GROUP BY grp)\nSELECT cells.t AS time, usual.grp AS grp,\n       round(100.0 * coalesce(counts.n, 0) / usual.n) AS pct\nFROM cells CROSS JOIN usual\nLEFT JOIN counts ON counts.grp = usual.grp AND counts.t = cells.t\nORDER BY 1, 2"
        }
      ],
      "interval": "1h",
      "maxDataPoints": 200,
      "transformations": [
